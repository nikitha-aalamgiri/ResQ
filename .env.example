# ResQ Root Environment Template
# Copy this file or individual service templates to .env

# Server Configuration
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Supabase Credentials (shared)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Demo Citizen Configuration (for seed-demo-citizen.js)
DEMO_CITIZEN_NAME=Citizen Demo
DEMO_CITIZEN_EMAIL=citizen.demo@example.com
DEMO_CITIZEN_PHONE=9876543210

# SMS Provider Configuration ("mock" or "msg91" - default "mock")
SMS_PROVIDER=mock

# MSG91 Configuration (India SMS Gateway - server-only secrets)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=RESQIN
MSG91_FLOW_ID_SOS_CREATED=your-flow-id-sos-created
MSG91_FLOW_ID_RESPONDER_ASSIGNED=your-flow-id-responder-assigned
MSG91_FLOW_ID_ON_THE_WAY=your-flow-id-on-the-way
MSG91_FLOW_ID_ARRIVED=your-flow-id-arrived
MSG91_FLOW_ID_RESCUED=your-flow-id-rescued

# Client Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=http://localhost:5000/api

# Optional Keyed Map Tile Provider (Recommended for high-traffic production use e.g. MapTiler, Stadia)
# If omitted, OpenStreetMap standard tiles (with Esri canvas fallback) are used automatically without an API key.
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/basic-v2/{z}/{x}/{y}.png?key=your-key
# VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.maptiler.com/">MapTiler</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
