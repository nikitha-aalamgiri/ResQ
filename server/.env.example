# Server Environment Variables
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Supabase Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Demo Citizen (for seed-demo-citizen.js - configure your local test phone)
DEMO_CITIZEN_NAME=Citizen Demo
DEMO_CITIZEN_EMAIL=citizen.demo@example.com
DEMO_CITIZEN_PHONE=9876543210

# SMS Provider ("mock" or "msg91" - default is "mock")
SMS_PROVIDER=mock

# MSG91 SMS Gateway Configuration (Server-only secrets, NEVER prefix with VITE_)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=RESQIN
MSG91_FLOW_ID_SOS_CREATED=your-flow-id-sos-created
MSG91_FLOW_ID_RESPONDER_ASSIGNED=your-flow-id-responder-assigned
MSG91_FLOW_ID_ON_THE_WAY=your-flow-id-on-the-way
MSG91_FLOW_ID_ARRIVED=your-flow-id-arrived
MSG91_FLOW_ID_RESCUED=your-flow-id-rescued
